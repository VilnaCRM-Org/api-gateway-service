Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "mutation ($input: UpdateUserRoleInput!) { updateUserRole(input: $input) { id subject { kind id } roleId roleName scope { kind projectId } expiresAt version createdAt updatedAt } }",
  "variables": { "input": { "id": "01a1c6b5-cb86-7134-868a-7608036facff", "expectedVersion": 1, "expiresAt": null } }
}

