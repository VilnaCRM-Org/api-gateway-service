  "variables": { "input": { "host": "app.example.test", "methods": ["GET"], "pathPattern": "/api/orders/{id}", "service": "core", "upstreamId": "01a1c6b5-cb86-7134-868a-7608036facfe", "idempotencyKey": "create-orders-route-gql" } }
}

### Read a route over REST: 200 with its ETag; 404 for an unknown or deleted id; 422 for an id that is not a UUID
GET {{baseUrl}}/api/routes/01a1c6b5-cb86-7134-868a-7608036facff
Authorization: Bearer <caller token>

### Read a route over GraphQL: null for an unknown or deleted id
POST {{baseUrl}}/api/graphql
Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "query ($id: ID!) { route(id: $id) { id host methods pathPattern service upstreamId anonymous enforcement version } }",
  "variables": { "id": "01a1c6b5-cb86-7134-868a-7608036facff" }
}

### List routes over REST: a page of 1 to 100 routes with the nextCursor of the next page, filtered by host, upstream and service
GET {{baseUrl}}/api/routes?limit=30&host=app.example.test&service=core
Authorization: Bearer <caller token>

### List routes over GraphQL: the same page with cursor pagination and the filter input
POST {{baseUrl}}/api/graphql
Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "query ($first: Int, $after: String, $filter: RouteFilterInput) { routes(first: $first, after: $after, filter: $filter) { items { id host pathPattern service version } nextCursor } }",
  "variables": { "first": 30, "filter": { "host": "app.example.test", "service": "core" } }
}

### Update a route over REST: 200 with the new ETag and Iam-Policy-Version; only the members of the body change and "cors": null removes the policy; changing anonymous or enforcement needs iam:route:anonymous (403 otherwise) and is audited with the old and the new value; 428 without If-Match; 412 for a stale If-Match; 404 for an unknown id; 403 without the route key of the service; 409 for a conflict and for a system route
PATCH {{baseUrl}}/api/routes/01a1c6b5-cb86-7134-868a-7608036facff
Authorization: Bearer <caller token>
If-Match: "1"
Content-Type: application/json

{
  "requestTimeoutMs": 5000,
  "methods": ["GET"]
}

### Update a route over GraphQL: the same data as the REST operation; the error codes PRECONDITION_REQUIRED, PRECONDITION_FAILED, NOT_FOUND, FORBIDDEN, CONFLICT and VALIDATION_FAILED
POST {{baseUrl}}/api/graphql
Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "mutation ($input: UpdateRouteInput!) { updateRoute(input: $input) { id version requestTimeoutMs } }",
  "variables": { "input": { "id": "01a1c6b5-cb86-7134-868a-7608036facff", "expectedVersion": 1, "requestTimeoutMs": 5000 } }
}

### Delete a route over REST: 204 with the final ETag and Iam-Policy-Version, and a tombstone state record; 409 for a system route (system-entry); 428 without If-Match; 412 for a stale If-Match; 404 for an unknown or deleted id
DELETE {{baseUrl}}/api/routes/01a1c6b5-cb86-7134-868a-7608036facff
Authorization: Bearer <caller token>
If-Match: "1"

### Delete a route over GraphQL: the id, the final version and the policy version; the error codes PRECONDITION_REQUIRED, PRECONDITION_FAILED, NOT_FOUND, FORBIDDEN and CONFLICT
POST {{baseUrl}}/api/graphql
Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "mutation ($input: DeleteRouteInput!) { deleteRoute(input: $input) { id version policyVersion } }",
  "variables": { "input": { "id": "01a1c6b5-cb86-7134-868a-7608036facff", "expectedVersion": 1 } }
}

### Read the route configuration of a host over REST: 200 with the routes in the form that the replacement accepts and the version of the set as the ETag; a host without routes has an empty set; 422 for a host that is not a host name
GET {{baseUrl}}/api/route-configurations/app.example.test
Authorization: Bearer <caller token>

### Read the route configuration of a host over GraphQL: the same data as the REST operation, with the version to pass as expectedVersion
POST {{baseUrl}}/api/graphql
Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "query ($host: String!) { routeConfiguration(host: $host) { host version routes { methods pathPattern service upstreamId anonymous enforcement requestTimeoutMs } } }",
  "variables": { "host": "app.example.test" }
}

### Dry run of a route configuration over REST: 200 with the diff (added, changed and removed routes) and no write; If-Match is the ETag of the read; every check of the application runs, so the answer is the one the application would get (403, 409, 412, 422)
PUT {{baseUrl}}/api/route-configurations/app.example.test?dryRun=true
Authorization: Bearer <caller token>
If-Match: "891243091239043"
Content-Type: application/json

{
  "routes": [
    { "methods": ["GET"], "pathPattern": "/api/orders/{id}", "service": "core", "upstreamId": "01a1c6b5-cb86-7134-868a-7608036fa000", "requestTimeoutMs": 5000 },
    { "methods": ["POST"], "pathPattern": "/api/orders", "service": "core", "upstreamId": "01a1c6b5-cb86-7134-868a-7608036fa000" }
  ]
}

### Apply a route configuration over REST: replaces the full route set of the host atomically in one policy version (200 with the diff, the new ETag and Iam-Policy-Version); a set of more than ROUTE_CONFIGURATION_MAX_ROUTES routes is 422, a conflicting set 409 (route-table-conflict), a stale If-Match 412, a missing If-Match 428; a set that deletes a route, clears anonymous or moves enforcement from audit to enforce is revocation-class; anonymous or audit-only routes need iam:route:anonymous (403 otherwise)
PUT {{baseUrl}}/api/route-configurations/app.example.test
Authorization: Bearer <caller token>
If-Match: "891243091239043"
Content-Type: application/json

{
  "routes": [
    { "methods": ["GET"], "pathPattern": "/api/orders/{id}", "service": "core", "upstreamId": "01a1c6b5-cb86-7134-868a-7608036fa000", "requestTimeoutMs": 5000 },
    { "methods": ["POST"], "pathPattern": "/api/orders", "service": "core", "upstreamId": "01a1c6b5-cb86-7134-868a-7608036fa000" }
  ]
}

### Apply a route configuration over GraphQL: the same diff as the REST operation; dryRun true writes nothing; the error codes PRECONDITION_REQUIRED, PRECONDITION_FAILED, FORBIDDEN, CONFLICT and VALIDATION_FAILED
POST {{baseUrl}}/api/graphql
Authorization: Bearer <caller token>
Content-Type: application/json

{
  "query": "mutation ($input: ApplyRouteConfigurationInput!) { applyRouteConfiguration(input: $input) { dryRun version routeCount revocation added { pathPattern } changed { pathPattern changedFields } removed { pathPattern } policyVersion } }",
  "variables": { "input": {
    "host": "app.example.test",
    "expectedVersion": 891243091239043,
    "dryRun": true,
    "routes": [
      { "methods": ["GET"], "pathPattern": "/api/orders/{id}", "service": "core", "upstreamId": "01a1c6b5-cb86-7134-868a-7608036fa000", "requestTimeoutMs": 5000 }
    ]
  } }
}
