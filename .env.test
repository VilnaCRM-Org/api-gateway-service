# Test overrides, applied on top of .env: the same local stack, a separate database.
# LOCAL-ONLY placeholders. Nothing in this file is a secret.
APP_ENV=test
LOG_LEVEL=warn
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}_test
DATABASE_LISTEN_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}_test
# An absolute path: the test binaries run in their crate directories.
JWT_PUBLIC_KEYS_FILE=${PWD}/config/jwt/dev-public-keys.pem
# The compose broker: its PLAINTEXT listener and the relaxed gates of a single node (the same as .env, repeated so
# that a test run never depends on a developer's .env).
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_HOST}:${KAFKA_PORT}
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONFIG_GATES=relaxed
# Its SASL_SSL listener and the TLS material that `scripts/kafka-tls-fixture.sh` generates (Story 1.5).
KAFKA_SASL_SSL_BOOTSTRAP_SERVERS=${KAFKA_HOST}:${KAFKA_SASL_SSL_PORT}
KAFKA_TLS_DIR=${PWD}/target/kafka-tls
# Static endpoint discovery: no Kubernetes API in the tests. An absolute path, like the key file.
UPSTREAM_DISCOVERY=static
UPSTREAM_STATIC_ENDPOINTS_FILE=${PWD}/config/upstream/dev-static-endpoints.json
