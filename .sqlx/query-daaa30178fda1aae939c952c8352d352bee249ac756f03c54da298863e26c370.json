  "query": "SELECT id, name, description, kind, version, created_at, updated_at\n            FROM iam_roles\n            WHERE deleted_at IS NULL\n                AND ($1::uuid IS NULL OR id > $1)\n                AND ($2::text IS NULL OR starts_with(lower(name), lower($2)))\n                AND ($3::text IS NULL OR kind = $3)\n            ORDER BY id\n            LIMIT $4",
