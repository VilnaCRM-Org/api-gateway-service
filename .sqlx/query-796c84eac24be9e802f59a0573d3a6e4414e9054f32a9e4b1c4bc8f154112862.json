  "query": "SELECT id, service, content_hash, status, uploaded_by, created_at, activated_at,\n                retired_at\n            FROM iam_graphql_specs\n            WHERE ($1::uuid IS NULL OR id > $1)\n                AND ($2::text IS NULL OR service = $2)\n                AND ($3::text IS NULL OR status = $3)\n            ORDER BY id\n            LIMIT $4",
