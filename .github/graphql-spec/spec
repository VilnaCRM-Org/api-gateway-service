  "Only assignments scoped to this project."
  projectId: String
  "Only assignments of this role."
  roleId: String
  "Only assignments of the subject with this id: a user UUID or a service name."
  subjectId: String
  "Only assignments of subjects of this kind: `user` or `service`."
  subjectKind: String
