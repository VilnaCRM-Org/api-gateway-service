# Development defaults for the local compose stack and for `cargo run`.
# LOCAL-ONLY placeholders. Nothing in this file is a secret; never reuse a value outside a developer machine.
APP_ENV=dev
APP_PORT=8081
LOG_LEVEL=info

DB_VERSION=16
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=local-dev-only
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_LISTEN_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_SQS=http://${LOCALSTACK_HOST}:${LOCALSTACK_PORT}

# The compose Kafka broker (development and test only).
KAFKA_HOST=localhost
KAFKA_PORT=9092
# The host port of its SASL_SSL listener (SCRAM-SHA-512 over TLS, Story 1.5).
KAFKA_SASL_SSL_PORT=9094
# The control-plane Kafka connection (Story 7.3): the compose broker over PLAINTEXT with the relaxed gates of a
# single node. Both are refused outside APP_ENV dev and test; production uses SASL_SSL and enforce.
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_HOST}:${KAFKA_PORT}
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONFIG_GATES=relaxed
KAFKA_TRANSACTION_TIMEOUT=10s
POLICY_TOPIC=iam.policy.state.v1
EVENTS_TOPIC=iam.events.v1

# The development key file holds a public key only; its private half is not committed, so no token verifies
# against it. Point the variable at your own key file (or the e2e world's ephemeral one) to accept tokens.
JWT_PUBLIC_KEYS_FILE=config/jwt/dev-public-keys.pem
JWT_ISSUER=vilnacrm-user-service
JWT_AUDIENCE=vilnacrm-api
JWT_CLOCK_SKEW=30s
MAX_TOKEN_LIFETIME=900s
TOKEN_MEMO_CAPACITY=200000
TOKEN_MEMO_MAX_TTL=900s
JWT_CALLER_AUDIENCE=vilnacrm-iam
JWT_SERVICE_TOKEN_MAX_LIFETIME=900s

# The maintenance task (Story 7.8): how often a pass runs, and how long an orphaned grant is kept before a pass purges it.
MAINTENANCE_INTERVAL=10m
ORPHANED_GRANT_RETENTION=90d

# The gateway (Story 9.2, `service gateway`): its three listeners and the identity of its pod. The certificate pair
# GATEWAY_TLS_CERT_FILE and GATEWAY_TLS_KEY_FILE is unset: APP_ENV dev and test serve plain HTTP without it.
GATEWAY_LISTEN=0.0.0.0:8443
GATEWAY_INTERNAL_LISTEN=0.0.0.0:9090
GATEWAY_PROBE_LISTEN=0.0.0.0:9092
POD_NAME=iam-gateway-local
POD_NAMESPACE=local
# Endpoint discovery (Story 10.1): compose and local runs read the endpoints of the upstreams from a file instead of
# the Kubernetes API; GATEWAY_ZONE is unset, so the zone is the one the file lists for this pod (or unknown).
UPSTREAM_DISCOVERY=static
UPSTREAM_STATIC_ENDPOINTS_FILE=config/upstream/dev-static-endpoints.json
UPSTREAM_ZONE_AWARE=true

STRUCTURIZR_PORT=8080
