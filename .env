# Development defaults for the local compose stack and for `cargo run`.
# LOCAL-ONLY placeholders. Nothing in this file is a secret; never reuse a value outside a developer machine.
APP_ENV=dev
APP_PORT=8081
LOG_LEVEL=info

DB_VERSION=16
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=local-dev-only
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_LISTEN_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566
# The compose Valkey (development and test only): the shared rate counters of the gateway (Story 12.2).
VALKEY_HOST=localhost
VALKEY_PORT=6379
# The compose Loki (development and test only): the log store of the audit lane of the access log (Story 14.2).
LOKI_HOST=localhost
LOKI_PORT=3100
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_SQS=http://${LOCALSTACK_HOST}:${LOCALSTACK_PORT}

# The compose Kafka broker (development and test only).
KAFKA_HOST=localhost
KAFKA_PORT=9092
# The host port of its SASL_SSL listener (SCRAM-SHA-512 over TLS, Story 1.5).
KAFKA_SASL_SSL_PORT=9094
# The control-plane Kafka connection (Story 7.3): the compose broker over PLAINTEXT with the relaxed gates of a
# single node. Both are refused outside APP_ENV dev and test; production uses SASL_SSL and enforce.
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_HOST}:${KAFKA_PORT}
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONFIG_GATES=relaxed
KAFKA_TRANSACTION_TIMEOUT=10s
PUBLISH_WAIT_TIMEOUT=5s
POLICY_TOPIC=iam.policy.state.v1
EVENTS_TOPIC=iam.events.v1

# The development key file holds a public key only; its private half is not committed, so no token verifies
# against it. Point the variable at your own key file (or the e2e world's ephemeral one) to accept tokens.
JWT_PUBLIC_KEYS_FILE=config/jwt/dev-public-keys.pem
JWT_ISSUER=vilnacrm-user-service
JWT_AUDIENCE=vilnacrm-api
JWT_CLOCK_SKEW=30s
MAX_TOKEN_LIFETIME=900s
TOKEN_MEMO_CAPACITY=200000
TOKEN_MEMO_MAX_TTL=900s
JWT_CALLER_AUDIENCE=vilnacrm-iam
JWT_SERVICE_TOKEN_MAX_LIFETIME=900s

# The maintenance task (Story 7.8): how often a pass runs, and how long an orphaned grant is kept before a pass purges it.
MAINTENANCE_INTERVAL=10m
ORPHANED_GRANT_RETENTION=90d

# The anti-entropy task (Story 7.7): how often it compares the head of the state topic with PostgreSQL, and how often it
# rebuilds the state from the whole topic (a shadow bootstrap) and compares the digest. The full interval is at least the head interval.
ANTI_ENTROPY_HEAD_INTERVAL=5s
ANTI_ENTROPY_FULL_INTERVAL=10m

# The bulk operation runner (Story 7.9): the most entities one version of a bulk change may change (1 to 1000), and the most
# records per second the runner commits.
BULK_CHUNK_ENTITIES=1000
BULK_MAX_RECORDS_PER_SECOND=2000

# The declarative route configuration (Story 8.6): the most routes one route configuration of a host may hold (1 to 1000).
ROUTE_CONFIGURATION_MAX_ROUTES=1000

# The gateway (Story 9.2, `service gateway`): its four listeners and the identity of its pod. The certificate pair
# GATEWAY_TLS_CERT_FILE and GATEWAY_TLS_KEY_FILE is unset: APP_ENV dev and test serve plain HTTP without it.
GATEWAY_LISTEN=0.0.0.0:8443
GATEWAY_INTERNAL_LISTEN=0.0.0.0:9090
GATEWAY_PROBE_LISTEN=0.0.0.0:9092
GATEWAY_DECISION_LISTEN=0.0.0.0:9091
GATEWAY_MESH_LISTEN=0.0.0.0:8444
# Whether every connection of the public listener starts with a Proxy Protocol v2 header (Story 10.9).
GATEWAY_PROXY_PROTOCOL=false
POD_NAME=iam-gateway-local
POD_NAMESPACE=local
# The tail of the state topic (Story 9.4): the fetch wait, the longest random delay before a fenced pod rebootstraps and
# the longest it keeps serving its last verified snapshot (3s to 30s, above the ready bound), and how often the apply
# thread checks a sixteenth of the shards against the raw records (Story 9.6).
KAFKA_FETCH_MAX_WAIT=100ms
FRESHNESS_READY_BOUND=2s
FRESHNESS_HARD_BOUND=15s
FRESHNESS_PROBE_INTERVAL=500ms
DERIVED_STATE_CHECK_INTERVAL=1s
# The last ready pods of a zone that never go unready for staleness (Story 15.1, 1 to 8).
READINESS_AZ_FLOOR=1
# The longest a request waits for a snapshot of the policy version it names (Story 10.10).
RYW_MAX_WAIT=1s
# How long a WebSocket or SSE stream may carry no traffic before the gateway closes it (Story 11.1).
STREAM_IDLE_TIMEOUT=5m
# What one subject may spend on parsing GraphQL documents that the document cache does not hold (Story 10.8).
GRAPHQL_PARSE_MISSES_PER_SECOND=20
GRAPHQL_PARSE_BYTES_PER_SECOND=1048576
# Endpoint discovery (Story 10.1): compose and local runs read the endpoints of the upstreams from a file instead of
# the Kubernetes API; GATEWAY_ZONE is unset, so the zone is the one the file lists for this pod (or unknown).
UPSTREAM_DISCOVERY=static
UPSTREAM_STATIC_ENDPOINTS_FILE=config/upstream/dev-static-endpoints.json
UPSTREAM_ZONE_AWARE=true
# The exact global quotas of the rate policies (Story 12.2): the compose Valkey, and the longest one call of it may
# take (1ms to 50ms). After five consecutive failures or timeouts the breaker (Story 12.3) opens for the open duration
# (1s to 5m) and the conservative local limiter decides, then one probe call checks the store again.
RATE_LIMIT_STORE_URL=redis://${VALKEY_HOST}:${VALKEY_PORT}
RATE_LIMIT_STORE_TIMEOUT=10ms
RATE_LIMIT_BREAKER_OPEN_DURATION=5s
RATE_LIMIT_GUARD_LIMIT=2000
RATE_LIMIT_GUARD_PERIOD=1s
RATE_LIMIT_GUARD_BURST=2000
# The access log (Story 14.1): the share of ordinary allows that is written, the records per second of the error and
# audit classes before the writer aggregates, and the capacity of the channel to the writer thread.
LOG_ALLOW_SAMPLE_RATE=0.01
LOG_CLASS_BUDGETS=error=1000,audit=2000
LOG_CHANNEL_CAPACITY=65536
# The audit lane (Story 14.2): the compose Loki, the tenant of its pushes, how often the audit records are pushed and
# how long the oldest one may wait for Loki's acknowledgement before audited requests are refused.
LOKI_PUSH_URL=http://${LOKI_HOST}:${LOKI_PORT}/loki/api/v1/push
LOKI_TENANT_ID=iam
ACCESS_LOG_AUDIT_FLUSH_INTERVAL=1s
ACCESS_LOG_AUDIT_MAX_PENDING=5s
# The access decision queries (Story 14.3): the base URL of the compose Loki that stores the audit lane, the longest
# time range of one query and how long a query may take before it fails with 504.
LOKI_QUERY_URL=http://${LOKI_HOST}:${LOKI_PORT}
ACCESS_LOG_QUERY_MAX_RANGE=24h
ACCESS_LOG_QUERY_TIMEOUT=5s

STRUCTURIZR_PORT=8080
